# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- app -------------------------------------------------------------------
APP_NAME="KNSB Motor Designer"
ENVIRONMENT=development            # development | production | test
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- security -----------------------------------------------------------
# REQUIRED in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<your-secret-key-here>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=true                 # true behind HTTPS
COOKIE_DOMAIN=                     # e.g. .example.com

# --- database ---------------------------------------------------------
# dev default is SQLite; production should be PostgreSQL:
# DATABASE_URL=postgresql+psycopg://knsb:<password>@db:5432/knsb
DATABASE_URL=sqlite+pysqlite:///./knsb_dev.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- concurrency (Section 12.2) --------------------------------------
API_WORKERS=4
SOLVER_PROCESSES=2
SIM_THREAD_WORKERS=4
SIMULATION_TIMEOUT_S=20
MISSION_TIMEOUT_S=45

# --- rate limits (per IP, per minute) ------------------------------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_SIM_PER_MIN=30
RATE_LIMIT_MISSION_PER_MIN=10

# --- email verification (optional; disabled when SMTP_HOST unset) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- filesystem ---------------------------------------------------
OUTPUTS_DIR=./outputs
LOCALES_DIR=                       # defaults to <repo>/locales

# --- postgres container (docker compose) -------------------------
POSTGRES_USER=knsb
POSTGRES_PASSWORD=<db-password-here>
POSTGRES_DB=knsb

# --- caddy / TLS ------------------------------------------------
DOMAIN=localhost
ACME_EMAIL=you@example.com
